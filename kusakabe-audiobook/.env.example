# Settings for scripts/make_audio.py (Fish Audio Drama 3 via OpenRouter).
# Copy to .env and fill in. .env is git-ignored.
OPENROUTER_API_KEY=
TTS_MODEL=fish-audio/drama-3
# Fish Audio voice reference_id. 933563129e564b19a115bedd57b7406a = "Sarah" (Fish Official).
# Empty = the model's default voice.
TTS_VOICE=933563129e564b19a115bedd57b7406a
# Max characters per request; files are split at paragraph boundaries
TTS_MAX_CHARS=1800
