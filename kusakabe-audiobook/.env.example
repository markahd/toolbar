# Fish Audio settings for scripts/fish_tts.py
# Copy to .env and fill in. .env is git-ignored.
FISH_API_KEY=
# reference_id of the Sarah voice in your Fish Audio account (Voice page -> copy ID)
FISH_VOICE_ID=
# Fish Audio TTS model header, e.g. s1 or speech-1.6
FISH_MODEL=s1
FISH_FORMAT=mp3
# Max characters per request; files are split at paragraph boundaries
FISH_MAX_CHARS=1800
