# Settings for scripts/make_audio.py (Fish Audio Drama 3 via OpenRouter).
# Copy to .env and fill in. .env is git-ignored.
OPENROUTER_API_KEY=
TTS_MODEL=fish-audio/drama-3
# Empty = the model's default voice (Sarah). Or a Fish Audio voice reference_id.
TTS_VOICE=
# Max characters per request; files are split at paragraph boundaries
TTS_MAX_CHARS=1800
